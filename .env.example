# Copie para .env e descomente o que quiser sobrescrever.

# Fonte dos zips (padrão: espelho Casa dos Dados com CDN; fonte primária no README)
#CNPJ_BASE_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos/

